# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ─── Flask ──────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# ─── Database ───────────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# ─── DigitalOcean Spaces ────────────────────────────────
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=coconut-grove-assets
SPACES_KEY=
SPACES_SECRET=
SPACES_CDN_ENDPOINT=https://coconut-grove-assets.nyc3.cdn.digitaloceanspaces.com

# ─── Stripe ─────────────────────────────────────────────
# Use test keys (pk_test_..., sk_test_...) until going live
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── SendGrid ───────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=orders@coconut-groove.com

# ─── AI Image Generation (TBD) ──────────────────────────
# Filled in when we pick the provider
# IMAGE_GEN_PROVIDER=
# IMAGE_GEN_API_KEY=
